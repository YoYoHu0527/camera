name = "camera-feishu-notify"
main = "feishu-notify.js"
compatibility_date = "2026-08-19"

[vars]
# GitHub Pages 的完整来源，不要以斜杠结尾。
ALLOWED_ORIGIN = "https://YOUR-NAME.github.io"

# 不要在此文件中填写飞书应用参数。
# 使用以下命令保存为 Worker secret：
# npx wrangler secret put FEISHU_APP_ID
# npx wrangler secret put FEISHU_APP_SECRET
# npx wrangler secret put FEISHU_CHAT_ID
